# Copy these values into Coolify's environment variables.
# Do not commit a filled production .env with real secrets.

# Public URLs routed by Coolify. Use HTTPS domains.
# In Coolify these may be omitted if SERVICE_URL_UI_3010,
# SERVICE_URL_API_8000 and SERVICE_URL_MINIO_9000 are generated from the
# compose file. If you set PUBLIC_* values manually, they must be real URLs
# with http:// or https://, not placeholder text.
PUBLIC_UI_URL=https://dograh.example.de
PUBLIC_BACKEND_URL=https://dograh-api.example.de
PUBLIC_MINIO_URL=https://dograh-files.example.de

# Database.
POSTGRES_USER=dograh
POSTGRES_DB=dograh
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Redis.
REDIS_PASSWORD=replace-with-a-long-random-password

# Local object storage for recordings/transcripts.
# Spike note: this uses Dograh's upstream MinIO behavior unchanged. Do not use
# this profile for real caller data until storage hardening is explicitly decided.
# Use URL-safe random values for passwords/secrets, because DATABASE_URL and
# REDIS_URL are assembled from these variables.
MINIO_ROOT_USER=dograhminio
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password
MINIO_BUCKET=voice-audio

# Dograh OSS auth/session signing.
OSS_JWT_SECRET=replace-with-at-least-32-random-bytes

# Workers. Keep FASTAPI_WORKERS at 1 in docker-compose.coolify.yml unless you
# also add an internal load balancer for the extra uvicorn ports.
ARQ_WORKERS=1
LOG_LEVEL=INFO

# Optional TURN configuration for reliable browser/WebRTC calls.
TURN_HOST=
TURN_SECRET=
FORCE_TURN_RELAY=false

# Storage alternative: set ENABLE_AWS_S3=true only after configuring the
# Dograh S3 variables supported by the API image. Keep region/provider in the EU.
ENABLE_AWS_S3=false
